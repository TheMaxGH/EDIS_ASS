# =============================================================================
# Пример файла переменных окружения для Dual Qwen Brain
# =============================================================================
# Скопируй этот файл в .env и заполни своими значениями
# cp .env.example .env

# HuggingFace (опционально, для приватных моделей)
HF_TOKEN=your_huggingface_token_here

# Tavily API (для автономного режима - веб поиск)
TAVILY_API_KEY=your_tavily_api_key_here

# GitHub Token (для автономного режима - мониторинг трендов)
GITHUB_TOKEN=your_github_token_here

# DoRA Fine-tuning настройки
SKIP_DORA=false          # true = пропустить DoRA обучение
DORA_EPOCHS=3            # количество эпох обучения

# Автономный режим
AUTONOMY_ENABLED=false   # true = включить фоновый мониторинг
RUN_SYSTEM=true          # true = запустить систему после установки

# GPU настройки
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7  # какие GPU использовать
